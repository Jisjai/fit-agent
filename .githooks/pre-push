#!/bin/sh
# Runs before every `git push`. If any test fails, the push is cancelled,
# so broken code never reaches GitHub (and therefore never reaches Vercel).
# Emergency bypass, if you really need it: git push --no-verify

echo "Running tests before push..."
if [ -x .venv/bin/python ]; then
  .venv/bin/python -m pytest -q
else
  python3 -m pytest -q
fi
status=$?
if [ $status -ne 0 ]; then
  echo ""
  echo "Push cancelled: tests failed. Fix them, then push again."
  exit 1
fi
